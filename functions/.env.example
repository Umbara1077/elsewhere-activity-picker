# Optional: local venue and nationwide ticketed-event APIs.
# These values stay on the server. Never prefix them with VITE_.
TICKETMASTER_API_KEY=
GOOGLE_PLACES_API_KEY=
# Optional HTTPS public calendars that expose JSON-LD Event records with coordinates.
# The crawler respects robots.txt and skips unsupported or undated records.
PUBLIC_EVENT_SOURCES=
# Optional operator-owned Overpass endpoint. Default: the public VK Maps instance.
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
